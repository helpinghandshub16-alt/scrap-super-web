rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sirf ye email admin hai — apna admin email yahan likhein
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "ADMIN_EMAIL_YAHAN";
    }
    function okPhone(p) { return p is string && p.matches('^[6-9][0-9]{9}$'); }
    function okText(s, n) { return s is string && s.size() <= n; }

    // Rates aur News: sab dekh sakte hain, sirf admin badal sakta hai
    match /rates/{id} { allow read: if true; allow write: if isAdmin(); }
    match /news/{id}  { allow read: if true; allow write: if isAdmin(); }

    // Orders: customer naya order bana sakta hai; booking number se sirf apna order dekh sakta hai
    match /orders/{id} {
      allow create: if id.matches('^SS[A-Z0-9]{6}$')
        && okText(request.resource.data.name, 100) && request.resource.data.name.size() > 0
        && okPhone(request.resource.data.phone)
        && okText(request.resource.data.address, 500)
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 40
        && request.resource.data.status == "Naya"
        && !('finalAmount' in request.resource.data);
      allow get: if true;                       // track page (booking number zaroori)
      allow list, update, delete: if isAdmin(); // poori list sirf admin
    }

    // Job aavedan aur contact messages: koi bhi bhej sakta hai, sirf admin dekh sakta hai
    match /applications/{id} {
      allow create: if okText(request.resource.data.name, 100) && okPhone(request.resource.data.phone)
        && okText(request.resource.data.experience, 500) && request.resource.data.status == "Naya";
      allow read, update, delete: if isAdmin();
    }
    match /messages/{id} {
      allow create: if okText(request.resource.data.name, 100) && okPhone(request.resource.data.phone)
        && okText(request.resource.data.message, 2000) && request.resource.data.status == "Naya";
      allow read, update, delete: if isAdmin();
    }
  }
}
